# Convenience wrapper around the CMake presets. CMake stays the source of
# truth; every target here is one or two plain cmake/ctest commands, so
# anything you can do here you can also do by hand (see README.md).
#
#   make                        build the selected board
#   make configure BOARD=<board>
#                               select a board; remembered for later commands
#   make BOARD=<board>          build another board once, without selecting it
#   make flash                  build, then flash (OpenOCD unless reconfigured)
#   make configure FLASH_TOOL=stlink
#                               switch flash tool: openocd, stlink or cubeprog
#   make help                   list everything

BOARDS := {{ boards | join(' ') }}
DEFAULT_BOARD := {{ boards[0] }}

# `make configure` records BOARD here so plain `make` / `make flash` keep using
# it. Inside build/, so it is git-ignored and `make distclean` forgets it. A
# BOARD on the command line or in the environment still wins for that command.
BOARD_FILE := build/.board
SAVED_BOARD := $(strip $(shell cat $(BOARD_FILE) 2>/dev/null))
BOARD ?= $(or $(SAVED_BOARD),$(DEFAULT_BOARD))

ifeq ($(origin BOARD),file)
BOARD_SOURCE := $(if $(SAVED_BOARD),selected with make configure,default)
else
BOARD_SOURCE := from $(origin BOARD)
endif

BUILD_DIR := build/$(BOARD)
HOST_TEST_DIR := build/host-test

# Passed through to CMake only when given, e.g. `make configure FLASH_TOOL=stlink`.
# It lands in the CMake cache, so later plain `make flash` keeps using it.
CONFIGURE := cmake --preset $(BOARD)$(if $(FLASH_TOOL), -DFLASH_TOOL=$(FLASH_TOOL))

# Skipped for distclean and help, so a saved board that no longer exists (say,
# after `copier update` dropped it) can still be inspected and forgotten.
ifneq ($(filter-out distclean help,$(or $(MAKECMDGOALS),build)),)
ifeq ($(filter $(BOARD),$(BOARDS)),)
$(error Unknown BOARD '$(BOARD)' ($(BOARD_SOURCE)). Choose one of: $(BOARDS)$(if $(and $(SAVED_BOARD),$(filter file,$(origin BOARD))), -- select one with make configure BOARD=<board> or forget it with make distclean))
endif
endif

.DEFAULT_GOAL := build
.PHONY: build configure flash test clean distclean help{% if boards | length > 1 %} all-boards{% endif %}

# Configure only when the build tree is missing or the presets have changed.
# After that, `cmake --build` re-runs configure itself if a CMakeLists.txt changes.
$(BUILD_DIR)/CMakeCache.txt: CMakePresets.json
	$(CONFIGURE)

$(HOST_TEST_DIR)/CMakeCache.txt:
	cmake -S test -B $(HOST_TEST_DIR)

build: $(BUILD_DIR)/CMakeCache.txt ## Build firmware for BOARD
	cmake --build --preset $(BOARD)

configure: ## Configure BOARD and select it for later commands (accepts FLASH_TOOL=...)
	$(CONFIGURE)
	@echo $(BOARD) > $(BOARD_FILE)

flash: $(BUILD_DIR)/CMakeCache.txt ## Build, then flash BOARD with FLASH_TOOL
	cmake --build --preset $(BOARD) --target flash
{% if boards | length > 1 %}
all-boards: ## Build firmware for every board
	set -e; for b in $(BOARDS); do $(MAKE) --no-print-directory build BOARD=$$b; done
{% endif %}
test: $(HOST_TEST_DIR)/CMakeCache.txt ## Build and run host unit tests
	cmake --build $(HOST_TEST_DIR)
	ctest --test-dir $(HOST_TEST_DIR) --output-on-failure

clean: ## Delete BOARD's build directory
	rm -rf $(BUILD_DIR)

distclean: ## Delete every build directory and forget the selected board
	rm -rf build

help: ## List targets
	@echo "Usage: make [target] [BOARD=<board>]"
	@echo "Board:  $(BOARD) ($(BOARD_SOURCE))"
	@echo "Boards: $(BOARDS)"
	@echo
	@awk -F':.*## ' '/^[a-z-]+:.*## / { printf "  %-12s %s\n", $$1, $$2 }' $(firstword $(MAKEFILE_LIST))
