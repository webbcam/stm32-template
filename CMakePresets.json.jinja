{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
{%- for b in boards %}
    {
      "name": "{{ b }}",
      "displayName": "{{ board_meta[b]['label'] }}",
      "binaryDir": "${sourceDir}/build/{{ b }}",
      "cacheVariables": {
        "BOARD": "{{ b }}",
        "OPENOCD_TARGET": "{{ board_meta[b]['openocd'] }}",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain-arm-none-eabi.cmake",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }{{ "," if not loop.last }}
{%- endfor %}
  ],
  "buildPresets": [
{%- for b in boards %}
    { "name": "{{ b }}", "configurePreset": "{{ b }}" }{{ "," if not loop.last }}
{%- endfor %}
  ]
}
