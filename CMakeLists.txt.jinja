cmake_minimum_required(VERSION 3.25)

set(BOARD "{{ board }}" CACHE STRING "Target board (see boards/)")

project({{ project_slug }} C ASM)

# Order matters. board.cmake defines MCU_FAMILY/MCU_DEFINE/CPU_FLAGS/
# HAL_CONF_DIR as plain variables, and everything below consumes them:
# compiler_flags.cmake needs CPU_FLAGS (Cortex-M4F vs M3 differ), and
# third_party needs MCU_FAMILY to pick which HAL to build plus MCU_DEFINE at
# the vendor sources' own compile time — not merely at link time.
include(boards/${BOARD}/board.cmake)
include(cmake/compiler_flags.cmake)

add_subdirectory(third_party)
add_subdirectory(boards/${BOARD})
add_subdirectory(src)
